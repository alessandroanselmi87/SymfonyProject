{% extends 'base.html.twig' %}

{% block title %}Hello OrderController!{% endblock %}

{% block body %}
<style>
    .example-wrapper { margin: 1em auto; max-width: 800px; width: 95%; font: 18px/1.5 sans-serif; }
    .example-wrapper code { background: #F5F5F5; padding: 2px 6px; }
</style>

<a href="{{ path('order_create') }}">
    {% trans %}order.title.create{% endtrans %}
</a>

<div class="example-wrapper">
    {% for order in orders %}
    <ul>
        <li>Id: 
            <a href="{{ path('order_edit', { id: order.id }) }}">
                {{ order.id }}
            </a>
        </li>
        <li>Client: {{ order.client.firstName }} {{ order.client.lastName }}</li>
        <li>OrderDate: {{ order.orderDate|date('d-m-Y') }}</li>
        <li>Status: {{ order.status }}</li>
        <li>Total: {{ order.total }}</li>
    </ul>
    <a href="{{ path('app_order', { id: order.id }) }}">
        {% trans %}order.show{% endtrans %}
    </a>
    <a href="{{ path('order_delete', { id: order.id }) }}">
        {% trans %}order.title.delete{% endtrans %}
    </a>
    {% endfor %}
</div>
{% endblock %}
