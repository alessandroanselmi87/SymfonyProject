{% extends 'base.html.twig' %}

{% block title %}Hello World!{% endblock %}

{% block body %}
<style>
    .example-wrapper { margin: 1em auto; max-width: 800px; width: 95%; font: 18px/1.5 sans-serif; }
    .example-wrapper code { background: #F5F5F5; padding: 2px 6px; }
</style>

<div class="example-wrapper">
    <ul>
        <li>Id: {{ payment.id }}</li>
        <li>Order: {{ payment.order.total }}</li>
        <li>Date: {{ payment.paymentDate|date('Y-M-d') }}</li>
        <li>Method: {{ payment.paymentMethod }}</li>
        <li>Amount: {{ payment.amount }}</li>
        <li>Status: {{ payment.status }}</li>
        <li>Transaction: {{ payment.transactionId }}</li>
    </ul>
    <a href="{{ path('app_payments') }}">
        {% trans %}payment.back_to_index{% endtrans %}
    </a>
</div>
{% endblock %}
